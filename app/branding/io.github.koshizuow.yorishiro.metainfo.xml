<component type="desktop-application">
  <id>io.github.koshizuow.yorishiro</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT AND Apache-2.0</project_license>
  <name>Yorishiro</name>
  <summary>Live2D VTuber app with face tracking</summary>
  <developer id="io.github.koshizuow">
    <name>Yorishiro contributors</name>
  </developer>
  <description>
    <p>
      Yorishiro moves a Live2D model with your face, from an ordinary webcam. Tracking runs on your GPU through
      Vulkan, so it works with AMD, Intel and NVIDIA cards alike.
    </p>
    <ul>
      <li>Face, eyes, mouth and optional hand tracking, with sensitivity and smoothing per model part</li>
      <li>Expressions and animations on hotkeys</li>
      <li>Items pinned to the model, backgrounds, several models in one library</li>
      <li>Output to OBS through PipeWire with a transparent background, or a virtual camera</li>
    </ul>
  </description>
  <launchable type="desktop-id">io.github.koshizuow.yorishiro.desktop</launchable>
  <url type="homepage">https://github.com/koshizuow/yorishiro</url>
